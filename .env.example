# Copy to .env and fill in. Both are read from here or from the environment.

# TypeSafe / Jev — required for detection.
JEV_API_KEY=apikey_...

# Brave Search — required to look up a video's cast.
BRAVE_SEARCH_API_KEY=...

# Optional: contact for Wikipedia's User-Agent policy. Defaults to
# +http://localhost, which is fine for a local tool.
# WIKI_CONTACT=+https://example.com
